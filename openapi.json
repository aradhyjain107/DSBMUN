{
  "openapi": "3.1.0",
  "info": {
    "title": "DSB MUN 5.0 API & Vercel Developer Resources",
    "description": "Official machine API for querying DSB MUN 5.0 Model United Nations conference data, committee agendas, schedule, dress code, and Model Context Protocol (MCP) server endpoints.",
    "version": "1.0.0",
    "x-api-version": "v1",
    "x-deprecation-policy": "DSB MUN 5.0 API follows Semantic Versioning 2.0.0. Major version changes are published under versioned URL paths (e.g. /v1/, /v2/). Deprecation notices are communicated 90 days in advance via the Sunset header (RFC 8594) and Deprecation header (RFC 9261).",
    "x-sunset": "2029-08-01T00:00:00Z",
    "contact": {
      "name": "DSB MUN 5.0 Secretariat",
      "email": "dsbmun@gmail.com",
      "url": "https://dsbmun.vercel.app/contact"
    },
    "license": {
      "name": "MIT License",
      "url": "https://dsbmun.vercel.app/LICENSE"
    }
  },
  "servers": [
    {
      "url": "https://dsbmun.vercel.app",
      "description": "Production Vercel Deployment"
    }
  ],
  "paths": {
    "/v1/info": {
      "get": {
        "summary": "Get Conference Overview",
        "description": "Returns core metadata about DSB MUN 5.0 including dates, venue, theme, and host school.",
        "operationId": "getConferenceInfoV1",
        "responses": {
          "200": {
            "description": "Successful conference metadata response",
            "headers": {
              "RateLimit-Limit": { "schema": { "type": "integer" }, "description": "Maximum requests per minute (100)" },
              "RateLimit-Remaining": { "schema": { "type": "integer" }, "description": "Remaining requests in current quota window" },
              "RateLimit-Reset": { "schema": { "type": "integer" }, "description": "Seconds until quota resets" },
              "API-Version": { "schema": { "type": "string" }, "description": "Active API major version (v1)" },
              "Sunset": { "schema": { "type": "string" }, "description": "RFC 8594 Sunset HTTP header" },
              "Deprecation": { "schema": { "type": "string" }, "description": "RFC 9261 Deprecation header" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ConferenceInfo" }
              }
            }
          }
        }
      }
    },
    "/v1/committees": {
      "get": {
        "summary": "List All Simulation Committees",
        "description": "Returns list of all 9 committees with agendas, grade eligibility, and background guide status.",
        "operationId": "listCommitteesV1",
        "responses": {
          "200": {
            "description": "Array of 9 committees",
            "headers": {
              "RateLimit-Limit": { "schema": { "type": "integer" } },
              "RateLimit-Remaining": { "schema": { "type": "integer" } },
              "API-Version": { "schema": { "type": "string" } }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Committee" }
                }
              }
            }
          }
        }
      }
    },
    "/v1/schedule": {
      "get": {
        "summary": "Get Conference Schedule",
        "description": "Returns hour-by-hour schedule for Day 1 (1 August 2026) and Day 2 (2 August 2026).",
        "operationId": "getScheduleV1",
        "responses": {
          "200": {
            "description": "Daily schedule breakdown",
            "headers": {
              "RateLimit-Limit": { "schema": { "type": "integer" } },
              "RateLimit-Remaining": { "schema": { "type": "integer" } },
              "API-Version": { "schema": { "type": "string" } }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Schedule" }
              }
            }
          }
        }
      }
    },
    "/v1/dress-code": {
      "get": {
        "summary": "Get Dress Code Requirements",
        "description": "Returns official delegate dress code guidelines (Day 1: Indian Traditional, Day 2: Western Formal).",
        "operationId": "getDressCodeV1",
        "responses": {
          "200": {
            "description": "Dress code requirements",
            "headers": {
              "RateLimit-Limit": { "schema": { "type": "integer" } },
              "RateLimit-Remaining": { "schema": { "type": "integer" } },
              "API-Version": { "schema": { "type": "string" } }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DressCode" }
              }
            }
          }
        }
      }
    },
    "/v1/contacts": {
      "get": {
        "summary": "Get Secretariat Contact Details",
        "description": "Returns official email, Instagram handle, and leadership team contact information.",
        "operationId": "getContactInfoV1",
        "responses": {
          "200": {
            "description": "Secretariat contact details",
            "headers": {
              "RateLimit-Limit": { "schema": { "type": "integer" } },
              "RateLimit-Remaining": { "schema": { "type": "integer" } },
              "API-Version": { "schema": { "type": "string" } }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ContactInfo" }
              }
            }
          }
        }
      }
    },
    "/v1/mcp": {
      "get": {
        "summary": "Get MCP Server Manifest",
        "description": "Returns Model Context Protocol server capabilities, tools list, and version.",
        "operationId": "getMcpManifestV1",
        "responses": {
          "200": {
            "description": "MCP Server Manifest",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/McpManifest" }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Execute MCP Tool or Handshake",
        "description": "Handles JSON-RPC 2.0 requests for initialize, tools/list, and tools/call.",
        "operationId": "callMcpToolV1",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/McpRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON-RPC 2.0 Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/McpResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid JSON-RPC request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConferenceInfo": {
        "type": "object",
        "required": ["apiVersion", "name", "theme", "dates", "location", "committeesCount", "website", "documentation", "openApiSpec"],
        "properties": {
          "apiVersion": { "type": "string", "example": "v1" },
          "name": { "type": "string", "example": "DSB MUN 5.0" },
          "theme": { "type": "string", "example": "Evolution for Revolution" },
          "dates": { "type": "string", "example": "1–2 August 2026" },
          "location": { "type": "string", "example": "DSB International Public School, Rishikesh, Uttarakhand" },
          "committeesCount": { "type": "integer", "example": 9 },
          "website": { "type": "string", "format": "uri", "example": "https://dsbmun.vercel.app/" },
          "documentation": { "type": "string", "format": "uri", "example": "https://dsbmun.vercel.app/docs" },
          "openApiSpec": { "type": "string", "format": "uri", "example": "https://dsbmun.vercel.app/openapi.json" }
        }
      },
      "Committee": {
        "type": "object",
        "required": ["name", "agenda", "eligibility"],
        "properties": {
          "name": { "type": "string", "example": "UNHRC" },
          "agenda": { "type": "string", "example": "Addressing Human Rights Violations in the Middle East..." },
          "eligibility": { "type": "string", "example": "Grades 6–12" }
        }
      },
      "Schedule": {
        "type": "object",
        "required": ["day1", "day2"],
        "properties": {
          "day1": { "type": "string", "example": "Day 1 (1 Aug): 8:30 AM Registration, 10:30 AM Session I..." },
          "day2": { "type": "string", "example": "Day 2 (2 Aug): 8:30 AM Session III, 4:00 PM Closing Ceremony..." }
        }
      },
      "DressCode": {
        "type": "object",
        "required": ["day1", "day2", "prohibited"],
        "properties": {
          "day1": { "type": "string", "example": "Indian Traditional / Ethnic Attire" },
          "day2": { "type": "string", "example": "Western Formal Attire" },
          "prohibited": { "type": "string", "example": "Casual wear (jeans, t-shirts, shorts) is strictly prohibited." }
        }
      },
      "ContactInfo": {
        "type": "object",
        "required": ["email", "instagram", "principal", "secretaryGeneral", "directorGeneral", "webLead", "venue"],
        "properties": {
          "email": { "type": "string", "format": "email", "example": "dsbmun@gmail.com" },
          "instagram": { "type": "string", "example": "@dsbmun" },
          "principal": { "type": "string", "example": "Mr. Shiv Sehgal" },
          "secretaryGeneral": { "type": "string", "example": "Ishika Dhamanda" },
          "directorGeneral": { "type": "string", "example": "Plaksha" },
          "webLead": { "type": "string", "example": "Aradhy Jain" },
          "venue": { "type": "string", "example": "DSB International Public School, Rishikesh" }
        }
      },
      "McpManifest": {
        "type": "object",
        "required": ["name", "title", "description", "version", "transport", "capabilities", "tools"],
        "properties": {
          "name": { "type": "string", "example": "dsb-mun-5-mcp" },
          "title": { "type": "string", "example": "DSB MUN 5.0 Model Context Protocol Server" },
          "description": { "type": "string", "example": "Exposes DSB MUN 5.0 conference data as tools" },
          "version": { "type": "string", "example": "1.0.0" },
          "transport": {
            "type": "object",
            "required": ["type", "endpoint"],
            "properties": {
              "type": { "type": "string", "example": "http" },
              "endpoint": { "type": "string", "format": "uri", "example": "https://dsbmun.vercel.app/api/mcp" }
            }
          },
          "capabilities": {
            "type": "object",
            "required": ["tools", "resources"],
            "properties": {
              "tools": { "type": "boolean", "example": true },
              "resources": { "type": "boolean", "example": true }
            }
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "description"],
              "properties": {
                "name": { "type": "string", "example": "list_committees" },
                "description": { "type": "string", "example": "Lists all 9 committees" }
              }
            }
          }
        }
      },
      "McpRequest": {
        "type": "object",
        "required": ["jsonrpc", "method"],
        "properties": {
          "jsonrpc": { "type": "string", "example": "2.0" },
          "method": { "type": "string", "example": "tools/call" },
          "params": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "example": "list_committees" },
              "arguments": { "type": "object" }
            }
          },
          "id": { "type": "integer", "example": 1 }
        }
      },
      "McpResponse": {
        "type": "object",
        "required": ["jsonrpc", "result"],
        "properties": {
          "jsonrpc": { "type": "string", "example": "2.0" },
          "result": {
            "type": "object",
            "properties": {
              "content": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["type", "text"],
                  "properties": {
                    "type": { "type": "string", "example": "text" },
                    "text": { "type": "string", "example": "[\"UNHRC\", \"UNSC\"]" }
                  }
                }
              }
            }
          },
          "error": { "type": "object" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "statusCode"],
            "properties": {
              "code": { "type": "string", "example": "NOT_FOUND" },
              "message": { "type": "string", "example": "The requested API resource was not found." },
              "resolutionHint": { "type": "string", "example": "Check /openapi.json or /docs for available endpoints." },
              "statusCode": { "type": "integer", "example": 404 }
            }
          }
        }
      }
    }
  }
}
