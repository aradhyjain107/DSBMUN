{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/.well-known/mcp",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/.well-known/mcp.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*markdown.*)"
        }
      ],
      "destination": "/api/router?route=markdown"
    },
    {
      "source": "/v1/info",
      "destination": "/api/router?route=info"
    },
    {
      "source": "/v1/committees",
      "destination": "/api/router?route=committees"
    },
    {
      "source": "/v1/schedule",
      "destination": "/api/router?route=schedule"
    },
    {
      "source": "/v1/dress-code",
      "destination": "/api/router?route=dress-code"
    },
    {
      "source": "/v1/contacts",
      "destination": "/api/router?route=contacts"
    },
    {
      "source": "/v1/openapi.json",
      "destination": "/api/router?route=openapi"
    },
    {
      "source": "/v1/mcp",
      "destination": "/api/router?route=mcp"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/router?route=openapi"
    },
    {
      "source": "/openapi.yaml",
      "destination": "/api/router?route=openapi"
    },
    {
      "source": "/api/openapi.json",
      "destination": "/api/router?route=openapi"
    },
    {
      "source": "/docs",
      "destination": "/docs/index.html"
    },
    {
      "source": "/api/docs",
      "destination": "/docs/index.html"
    },
    {
      "source": "/.well-known/mcp",
      "destination": "/api/router?route=mcp"
    },
    {
      "source": "/.well-known/mcp.json",
      "destination": "/api/router?route=mcp"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/router?route=llms"
    },
    {
      "source": "/llms-full.txt",
      "destination": "/api/router?route=llms-full"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/router?route=sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/router?route=robots"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/api/:endpoint*",
      "destination": "/api/router"
    },
    {
      "source": "/v1/:endpoint*",
      "destination": "/api/router"
    },
    {
      "source": "/",
      "destination": "/api/router?route=home"
    },
    {
      "source": "/(.*)",
      "destination": "/api/router"
    }
  ]
}
