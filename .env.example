# DSB MUN 5.0 Environment Variable Template

# Application Configuration
NEXT_PUBLIC_APP_NAME="DSB MUN 5.0"
NEXT_PUBLIC_APP_URL="https://dsbmun.vercel.app"
NEXT_PUBLIC_CONFERENCE_DATE="2026-08-01T00:00:00+05:30"

# Firebase Cloud Integration
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="dsbmun-5.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="dsbmun-5"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="dsbmun-5.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="1234567890"
NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"

# Vercel Deployment & Analytics
NEXT_PUBLIC_VERCEL_ENV="production"
NEXT_PUBLIC_ANALYTICS_ID="your-analytics-id"
